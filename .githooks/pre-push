#!/usr/bin/env sh
# Refuse to push commits whose dates aren't UTC or whose author/committer
# isn't the repo's identity: commit metadata stays anonymous (CLAUDE.md,
# "Commit identity"). Fix with TZ=UTC and the repo-local user.name/email,
# then amend or rebase the listed commits.
# Then run the full test suite (pre-commit runs only the fast tier);
# MASHUP_PUSH_TESTS=0 skips it, keeping the identity check.
want_name=r0pi0x
want_email=339403489+r0pi0x@users.noreply.github.com
zero=0000000000000000000000000000000000000000
bad=0
pushing=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    pushing=1
    if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
    out=$(git log --format='%h %an|%ae|%ad|%cn|%ce|%cd' --date=format:%z "$range" |
        awk -F'|' -v n="$want_name" -v e="$want_email" '{
            split($1, a, " "); an = substr($1, length(a[1]) + 2)
            if (an != n || $2 != e || $3 != "+0000" || $4 != n || $5 != e || $6 != "+0000") print
        }')
    if [ -n "$out" ]; then
        echo "pre-push: these commits aren't by $want_name <$want_email> in UTC:" >&2
        echo "$out" >&2
        bad=1
    fi
    # Personal traces in what's being pushed (commit messages and added
    # lines): machine paths always, plus the case-insensitive patterns in
    # the git-ignored .githooks/private-patterns (one extended regex per
    # line, e.g. a real name), so the names themselves are never committed.
    patterns='/home/[A-Za-z0-9_.-]+/|/Users/[A-Za-z0-9_.-]+/|[A-Za-z]:\\+Users\\+[A-Za-z0-9_.-]'
    if [ -f .githooks/private-patterns ]; then
        extra=$(grep -v -e '^#' -e '^[[:space:]]*$' .githooks/private-patterns | paste -sd'|' -)
        [ -n "$extra" ] && patterns="$patterns|$extra"
    fi
    hits=$(git log -p --no-color --format='%n%B' "$range" | grep -E -i -n -e "^\+.*($patterns)" -e "^[^-+@ ].*($patterns)" | grep -v '^[0-9]*:+++ ' | head -10)
    if [ -n "$hits" ]; then
        echo "pre-push: personal traces (paths or private patterns) in what's being pushed:" >&2
        echo "$hits" | cut -c1-160 >&2
        bad=1
    fi
done
if [ "$bad" = 1 ]; then
    echo "pre-push: fix the commits above (TZ=UTC and the repo-local identity; remove personal traces), then amend/rebase them; not pushing." >&2
    exit 1
fi
if [ "$pushing" = 1 ]; then
    # The tests build with --features dev; playtest and release builds
    # don't. Check that configuration too (always: the suite can't catch
    # a dev-only dependency).
    mkdir -p target
    echo "pre-push: checking the build without --features dev..." >&2
    if ! cargo check --lib --bins --quiet >target/pre-push-check.log 2>&1; then
        grep -E "^error" -A6 target/pre-push-check.log | head -30
        echo "pre-push: the build without --features dev fails (log: target/pre-push-check.log); not pushing." >&2
        exit 1
    fi
fi
if [ "$pushing" = 1 ] && [ "${MASHUP_PUSH_TESTS:-1}" != 0 ]; then
    mkdir -p target
    log=target/pre-push.log
    echo "pre-push: running the full test suite (log: $log)..." >&2
    # nextest (a process per test) is twice as fast as one libtest process.
    if cargo nextest --version >/dev/null 2>&1; then
        run="cargo nextest run --features dev --no-fail-fast --color never"
    else
        run="cargo test --features dev --quiet --no-fail-fast"
    fi
    if ! $run >"$log" 2>&1; then
        grep -E "panicked|FAILED|FAIL \[|^error" "$log" | head -20
        echo "pre-push: tests failed (full log: $log); not pushing." >&2
        exit 1
    fi
fi
